from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.bulletin import BulletinHelper

__id__ = "deneme_eklenti"
__name__ = "Deneme Eklenti"
__description__ = "Test eklentisi: yüklenince bildirim gösterir, '.ping' yazınca 'pong' gönderir."
__author__ = "@deneme"
__version__ = "1.0.0"
__min_version__ = "11.9.0"


class DenemeEklenti(BasePlugin):
    def on_plugin_load(self):
        self.log("Deneme eklenti yüklendi")
        self.add_on_send_message_hook()
        try:
            BulletinHelper.show_info("Deneme eklenti çalışıyor ✅")
        except Exception as e:
            self.log(f"Bulletin hatası: {e}")

    def on_send_message_hook(self, account, params):
        try:
            if isinstance(params.message, str) and params.message.strip() == ".ping":
                params.message = "pong 🏓"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
        except Exception as e:
            self.log(f"Hook hatası: {e}")
        return HookResult()
