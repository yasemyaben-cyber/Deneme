from typing import Any

from base_plugin import BasePlugin, HookResult, HookStrategy

__id__ = "ayusmart_tr"
__name__ = "AyuSmart Türkçe"
__description__ = "Türkçe hızlı yanıt kısayolları. Sohbete .selam, .tesekkur, .mesgul, .sonra, .tamam veya .iyi_geceler yaz."
__author__ = "yasemyaben-cyber"
__version__ = "1.0.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["chats", "tools"]

RESPONSES = {
    ".selam": "Merhaba! 😊 Nasılsın?",
    ".tesekkur": "Çok teşekkür ederim. ❤️",
    ".mesgul": "Şu an biraz meşgulüm. İlk fırsatta sana dönüş yapacağım.",
    ".sonra": "Şu an uygun değilim, daha sonra konuşabilir miyiz?",
    ".tamam": "Tamamdır, anlaştık. 👍",
    ".iyi_geceler": "İyi geceler, tatlı rüyalar. 🌙",
}


class AyuSmartTurkish(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.logger.info("AyuSmart Türkçe etkinleştirildi")

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        message = getattr(params, "message", None)
        if not isinstance(message, str):
            return HookResult()

        replacement = RESPONSES.get(message.strip().lower())
        if replacement is None:
            return HookResult()

        params.message = replacement
        return HookResult(strategy=HookStrategy.MODIFY, params=params)
